# Database Configuration
# Format: mysql://username:password@host:port/database
# Example: mysql://root:password@localhost:3306/jm_fashion
DATABASE_URL="mysql://username:password@localhost:3306/jm_fashion"

# JWT Configuration
# Change this to a secure random string
JWT_SECRET="your-secret-key-change-this-to-a-random-string"

# VNPay Configuration
# Get these from your VNPay merchant account
VNPAY_MERCHANT_ID="your-merchant-id"
VNPAY_MERCHANT_KEY="your-merchant-key"
VNPAY_RETURN_URL="http://localhost:3000/api/payment/vnpay/return"

# Environment
NODE_ENV="development"

# Application URL (for production)
# NEXT_PUBLIC_APP_URL="https://yourdomain.com"

# Backend Express API URL (BE chạy port 3000, FE chạy port 3001)
NEXT_PUBLIC_API_URL="http://localhost:3000/api"
