DELIMITER $$

CREATE DEFINER=`root`@`%` PROCEDURE `SearchProducts`(
    IN p_search_content VARCHAR(500),
    IN p_categoryId VARCHAR(50),
    IN p_pageIndex INT,
    IN p_pageSize INT,
    OUT p_error_code INT,
    OUT p_error_message VARCHAR(500)
)
BEGIN
    DECLARE p_total_row INT;
    DECLARE EXIT HANDLER FOR SQLEXCEPTION
    BEGIN
        GET DIAGNOSTICS CONDITION 1
            p_error_code = RETURNED_SQLSTATE,
            p_error_message = MESSAGE_TEXT;
    END;

    SET p_error_code = 0;
    SET p_error_message = '';

    IF p_pageSize <> 0 THEN
        DROP TEMPORARY TABLE IF EXISTS SearchResults;
        
        CREATE TEMPORARY TABLE SearchResults AS
        SELECT 
            (@row_number := @row_number + 1) AS RowNumber,
            t.*
        FROM (
            SELECT 
                p.productId,
                p.productName,
                p.categoryId,
                c.categoryName,
                p.description,
                p.thumbnail,
                p.basePrice,
                p.activeFlag,
                p.userCreateId,
                p.luUserId,
                p.createdAt,
                p.updatedAt,
                COUNT(pv.variantId) as variantCount,
                COALESCE(SUM(pv.stock), 0) as totalStock
            FROM products p
            LEFT JOIN categories c ON p.categoryId = c.categoryId
            LEFT JOIN productVariants pv ON p.productId = pv.productId AND pv.activeFlag = 1
            WHERE p.activeFlag = 1
            AND (p_categoryId IS NULL OR p_categoryId = '' OR p.categoryId = p_categoryId)
            AND (p_search_content IS NULL OR p_search_content = ''
                OR LOWER(CONCAT(
                    COALESCE(p.productName, ''),
                    COALESCE(p.description, ''),
                    COALESCE(c.categoryName, '')
                )) LIKE CONCAT('%', LOWER(TRIM(p_search_content)), '%'))
            GROUP BY p.productId, p.productName, p.categoryId, c.categoryName, 
                     p.description, p.thumbnail, p.basePrice, p.activeFlag,
                     p.userCreateId, p.luUserId, p.createdAt, p.updatedAt
            ORDER BY p.createdAt DESC
        ) t
        CROSS JOIN (SELECT @row_number := 0) r;

        SELECT COUNT(*) INTO p_total_row FROM SearchResults;

        SELECT *, p_total_row AS RecordCount
        FROM SearchResults
        WHERE RowNumber BETWEEN ((p_pageIndex - 1) * p_pageSize) + 1 AND (p_pageIndex * p_pageSize);

        DROP TEMPORARY TABLE SearchResults;
    ELSE
        DROP TEMPORARY TABLE IF EXISTS SearchResults;
        
        CREATE TEMPORARY TABLE SearchResults AS
        SELECT 
            (@row_number := @row_number + 1) AS RowNumber,
            t.*
        FROM (
            SELECT 
                p.productId,
                p.productName,
                p.categoryId,
                c.categoryName,
                p.description,
                p.thumbnail,
                p.basePrice,
                p.activeFlag,
                p.userCreateId,
                p.luUserId,
                p.createdAt,
                p.updatedAt,
                COUNT(pv.variantId) as variantCount,
                COALESCE(SUM(pv.stock), 0) as totalStock
            FROM products p
            LEFT JOIN categories c ON p.categoryId = c.categoryId
            LEFT JOIN productVariants pv ON p.productId = pv.productId AND pv.activeFlag = 1
            WHERE p.activeFlag = 1
            AND (p_categoryId IS NULL OR p_categoryId = '' OR p.categoryId = p_categoryId)
            AND (p_search_content IS NULL OR p_search_content = ''
                OR LOWER(CONCAT(
                    COALESCE(p.productName, ''),
                    COALESCE(p.description, ''),
                    COALESCE(c.categoryName, '')
                )) LIKE CONCAT('%', LOWER(TRIM(p_search_content)), '%'))
            GROUP BY p.productId, p.productName, p.categoryId, c.categoryName, 
                     p.description, p.thumbnail, p.basePrice, p.activeFlag,
                     p.userCreateId, p.luUserId, p.createdAt, p.updatedAt
            ORDER BY p.createdAt DESC
        ) t
        CROSS JOIN (SELECT @row_number := 0) r;

        SELECT COUNT(*) INTO p_total_row FROM SearchResults;
        SELECT *, p_total_row AS RecordCount FROM SearchResults;

        DROP TEMPORARY TABLE SearchResults;
    END IF;
END$$

DELIMITER ;
