CREATE DATABASE clothingShopDB;
USE clothingShopDB;

-- =========================
-- USERS
-- =========================
CREATE TABLE users (
    userId VARCHAR(50) PRIMARY KEY,
    username VARCHAR(100) UNIQUE NOT NULL,
    password VARCHAR(255) NOT NULL,

    fullName VARCHAR(150),
    email VARCHAR(150),
    phone VARCHAR(20),
    address TEXT,

    role INT DEFAULT 1,
    -- 0 = STAFF
    -- 1 = CUSTOMER

    activeFlag TINYINT DEFAULT 1,
    userCreateId VARCHAR(50),
    luUserId VARCHAR(50),

    createdAt DATETIME,
    updatedAt DATETIME
);

-- =========================
-- CATEGORIES
-- =========================
CREATE TABLE categories (
    categoryId VARCHAR(50) PRIMARY KEY,
    categoryName VARCHAR(150) NOT NULL,
    description TEXT,

    activeFlag TINYINT DEFAULT 1,
    userCreateId VARCHAR(50),
    luUserId VARCHAR(50),

    createdAt DATETIME,
    updatedAt DATETIME
);

-- =========================
-- PRODUCTS
-- =========================
CREATE TABLE products (
    productId VARCHAR(50) PRIMARY KEY,
    productName VARCHAR(200) NOT NULL,

    categoryId VARCHAR(50),

    description TEXT,
    thumbnail VARCHAR(255),

    basePrice DECIMAL(12,2),

    activeFlag TINYINT DEFAULT 1,
    userCreateId VARCHAR(50),
    luUserId VARCHAR(50),

    createdAt DATETIME,
    updatedAt DATETIME,

    FOREIGN KEY (categoryId) REFERENCES categories(categoryId)
);

-- =========================
-- PRODUCT VARIANTS
-- =========================
CREATE TABLE productVariants (
    variantId VARCHAR(50) PRIMARY KEY,
    productId VARCHAR(50) NOT NULL,

    size VARCHAR(20),
    color VARCHAR(50),

    price DECIMAL(12,2),
    stock INT DEFAULT 0,

    activeFlag TINYINT DEFAULT 1,
    userCreateId VARCHAR(50),
    luUserId VARCHAR(50),

    createdAt DATETIME,
    updatedAt DATETIME,

    FOREIGN KEY (productId) REFERENCES products(productId)
);

-- =========================
-- PRODUCT IMAGES
-- =========================
CREATE TABLE productImages (
    imageId VARCHAR(50) PRIMARY KEY,
    productId VARCHAR(50),

    imageUrl VARCHAR(255),

    activeFlag TINYINT DEFAULT 1,
    userCreateId VARCHAR(50),
    luUserId VARCHAR(50),

    createdAt DATETIME,
    updatedAt DATETIME,

    FOREIGN KEY (productId) REFERENCES products(productId)
);

-- =========================
-- ORDERS
-- =========================
CREATE TABLE orders (
    orderId VARCHAR(50) PRIMARY KEY,

    userId VARCHAR(50),

    totalPrice DECIMAL(12,2),

    orderStatus INT DEFAULT 0,
    -- 0 = PENDING
    -- 1 = CONFIRMED
    -- 2 = SHIPPING
    -- 3 = COMPLETED
    -- 4 = CANCELLED

    shippingAddress TEXT,
    phone VARCHAR(20),

    activeFlag TINYINT DEFAULT 1,
    userCreateId VARCHAR(50),
    luUserId VARCHAR(50),

    createdAt DATETIME,
    updatedAt DATETIME,

    FOREIGN KEY (userId) REFERENCES users(userId)
);

-- =========================
-- ORDER DETAILS
-- =========================
CREATE TABLE orderDetails (
    orderDetailId VARCHAR(50) PRIMARY KEY,

    orderId VARCHAR(50),
    variantId VARCHAR(50),

    price DECIMAL(12,2),
    quantity INT,

    activeFlag TINYINT DEFAULT 1,
    userCreateId VARCHAR(50),
    luUserId VARCHAR(50),

    createdAt DATETIME,
    updatedAt DATETIME,

    FOREIGN KEY (orderId) REFERENCES orders(orderId),
    FOREIGN KEY (variantId) REFERENCES productVariants(variantId)
);

-- =========================
-- PAYMENTS
-- =========================
CREATE TABLE payments (
    paymentId VARCHAR(50) PRIMARY KEY,

    orderId VARCHAR(50),

    paymentMethod INT,
    -- 0 = COD
    -- 1 = BANK
    -- 2 = MOMO

    paymentStatus INT DEFAULT 0,
    -- 0 = PENDING
    -- 1 = SUCCESS
    -- 2 = FAILED

    amount DECIMAL(12,2),

    transactionCode VARCHAR(100),

    activeFlag TINYINT DEFAULT 1,
    userCreateId VARCHAR(50),
    luUserId VARCHAR(50),

    createdAt DATETIME,
    updatedAt DATETIME,

    FOREIGN KEY (orderId) REFERENCES orders(orderId)
);

-- =========================
-- PAYMENT HISTORY
-- =========================
CREATE TABLE paymentHistory (
    historyId VARCHAR(50) PRIMARY KEY,

    paymentId VARCHAR(50),

    oldStatus INT,
    newStatus INT,

    note TEXT,

    activeFlag TINYINT DEFAULT 1,
    userCreateId VARCHAR(50),
    luUserId VARCHAR(50),

    createdAt DATETIME,

    FOREIGN KEY (paymentId) REFERENCES payments(paymentId)
);

-- =========================
-- AUDIT LOGS
-- =========================
CREATE TABLE auditLogs (
    logId VARCHAR(50) PRIMARY KEY,

    tableName VARCHAR(100),
    recordId VARCHAR(50),

    actionType INT,
    -- 0 = CREATE
    -- 1 = UPDATE
    -- 2 = DELETE

    description TEXT,

    activeFlag TINYINT DEFAULT 1,
    userCreateId VARCHAR(50),
    luUserId VARCHAR(50),

    createdAt DATETIME
);



